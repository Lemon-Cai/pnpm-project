{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "src/**/*.tsx",],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "composite": true,
    
    // "jsx": "preserve",
    // "jsxImportSource": "vue",
    "isolatedModules": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
    }
  }
}
