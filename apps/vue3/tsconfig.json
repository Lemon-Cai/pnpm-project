{
  "references": [
    {
      "path": "./tsconfig.node.json"
    },
    {
      "path": "./tsconfig.app.json"
    }
  ],
  "include": [
    "env.d.ts", 
    "src/**/*", 
    "src/**/*.vue", 
    "src/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.js" 
  ],
  "exclude": ["node_modules", "dist", "src/**/__tests__/*"],
  "compilerOptions": {
    
    "outDir": "./dist", // 将输出目录设置为项目根目录下的 dist 文件夹

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    "isolatedModules": true,
    "allowJs": true,
    // Required in Vue projects
    "jsx": "preserve",
    "jsxImportSource": "vue",
    // "noEmit": true,
    // "allowImportingTsExtensions": true // 是否可加后缀
  }
}
